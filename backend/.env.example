# Backend (Strapi) — template for backend/.env
# Restore real values with: npm run env:pull (needs .env.key)

HOST=0.0.0.0
PORT=1337

APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
ADMIN_JWT_SECRET=change-me
API_TOKEN_SALT=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me

# Must match REVALIDATE_SECRET in .env.local
FRONTEND_URL=http://localhost:3000
WEBHOOK_TOKEN=change-me

# Default content locale in Content Manager
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=bg

# Strapi Cloud production
# DATABASE_URL=postgresql://...
