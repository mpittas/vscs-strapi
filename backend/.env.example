# Backend (Strapi) — template for backend/.env
# Restore real values with: npm run env:pull (needs .env.key)

HOST=0.0.0.0
PORT=1337

APP_KEYS=key1,key2
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me
JWT_SECRET=change-me

# CORS origin for the Next.js dev server
FRONTEND_URL=http://localhost:3000

# Must match REVALIDATE_SECRET in .env.local
WEBHOOK_TOKEN=change-me

# Local dev uses SQLite by default. For PostgreSQL:
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
