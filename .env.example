# Frontend (Next.js) — template for .env.local
# Restore real values with: npm run env:pull (needs .env.key)

NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Admin token for Cursor MCP — create in Strapi admin (Settings → Admin API Tokens)
# or run: npm run mcp:token --prefix backend
STRAPI_MCP_ADMIN_TOKEN=

# Production Strapi on Railway
# NEXT_PUBLIC_STRAPI_API_URL=https://strapi-production-7aaf.up.railway.app
# STRAPI_URL=https://strapi-production-7aaf.up.railway.app

# Mapbox token for the projects map (leave empty to disable)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Shared with Strapi webhooks for on-demand revalidation
REVALIDATE_SECRET=change-me

# ---------------------------------------------------------------------------
# Form email — temporary Gmail (local dev / testing until office@ is ready)
# Create an App Password: https://myaccount.google.com/apppasswords (2FA required)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=webpittas@gmail.com
SMTP_PASS=
SMTP_FROM="VSCS Website (dev) <webpittas@gmail.com>"
SMTP_TO=webpittas@gmail.com
SMTP_BCC=

# ---------------------------------------------------------------------------
# Form email — production office@ (SuperHosting cPanel)
# cPanel → Email Accounts → office@vscs-bg.com → Connect Devices
# Use IP until DNS is fixed: mail.vscs-bg.com must point to 185.45.66.26, not Vercel
# ---------------------------------------------------------------------------
# SMTP_HOST=185.45.66.26
# SMTP_PORT=465
# SMTP_USER=office@vscs-bg.com
# SMTP_PASS=
# SMTP_TLS_SERVERNAME=mail.vscs-bg.com
# SMTP_FROM="VSCS Website <office@vscs-bg.com>"
# SMTP_TO=office@vscs-bg.com
# SMTP_BCC=webpittas@gmail.com

# Optional: Resend API (alternative to SMTP — https://resend.com)
# RESEND_API_KEY=
# RESEND_FROM="VSCS Website" <office@vscs-bg.com>
