# Frontend (Next.js) — copy to .env.local via `npm run setup`
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337

# Optional: Mapbox token for the projects map (leave empty to disable the map)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Secret shared with Strapi webhooks for on-demand revalidation
REVALIDATE_SECRET=dev-secret-change-me

# Optional: SMTP for career application form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=careers@vscs-bg.com
SMTP_TO=hr@vscs-bg.com
